{
  "expo": {
    "name": "hermes-app",
    "slug": "hermes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermes.continental",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch", "remote-notification"],
        "NSMicrophoneUsageDescription": "O Hermes usa o microfone para ouvir a palavra \"continental\" e seus comandos de voz.",
        "NSSpeechRecognitionUsageDescription": "O Hermes converte sua fala em texto para responder aos seus comandos."
      }
    },
    "android": {
      "package": "com.hermes.continental",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C4DFF"
        }
      ],
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Hermes usa o microfone para ouvir seus comandos de voz.",
          "speechRecognitionPermission": "O Hermes converte sua fala em texto para responder aos seus comandos."
        }
      ]
    ]
  }
}
